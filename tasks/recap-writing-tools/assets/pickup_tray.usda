#usda 1.0
(
    defaultPrim = "Part"
    doc = """Generated from Composed Stage of root layer 
"""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Part"
{
    def "Materials"
    {
        def Material "DeskTray" (
            apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Part/Materials/DeskTray/Surface.outputs:surface>
            float physics:dynamicFriction = 0.304
            float physics:restitution = 0
            float physics:staticFriction = 0.38
            custom token physxMaterial:frictionCombineMode = "min"

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7176234, 0.77385217, 0.8324022)
                float inputs:roughness = 0.37
                token outputs:surface
            }
        }

        def Material "PickUpRest" (
            apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
