    float physics:mass = 0.0015
    custom float physxRigidBody:sleepThreshold = 0
    custom int physxRigidBody:solverPositionIterationCount = 24
    custom int physxRigidBody:solverVelocityIterationCount = 4
    custom float physxRigidBody:stabilizationThreshold = 0

    def "Materials"
    {
        def Material "ShellPlastic" (
            apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Part/Materials/ShellPlastic/Surface.outputs:surface>
            float physics:dynamicFriction = 0.36
            float physics:restitution = 0
            float physics:staticFriction = 0.45
            custom token physxMaterial:frictionCombineMode = "min"

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.022993205, 0.19894394, 0.9141063)
                float inputs:roughness = 0.37
                token outputs:surface
            }
        }

        def Material "CompliantBand" (
            apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Part/Materials/CompliantBand/Surface.outputs:surface>
            float physics:dynamicFriction = 0.36
            float physics:restitution = 0
            float physics:staticFriction = 0.45
            custom float physxMaterial:compliantContactDamping = 1
            custom float physxMaterial:compliantContactStiffness = 1600
            custom token physxMaterial:frictionCombineMode = "min"

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.008320486, 0.07199129, 0.3307851)
                float inputs:roughness = 0.37
                token outputs:surface
            }
        }
    }

