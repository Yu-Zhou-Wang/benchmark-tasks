#usda 1.0
(
    defaultPrim = "RearPlate"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "RearPlate" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    customData = {
        string taskMechanics = "Independent free glass plate; no hidden attachments."
    }
    doc = "Original reference-informed single-bay mini PAGE casting kit. Rear 101x82mm and front 101x73mm plates, nominal3mm glass thickness, bonded1mm spacers. Separate green frame with two vertical-axis pressure cams and transparent stand with horizontal-axis top spring clip. Nominal dimensions, masses and springs outside the manufacturer-specified plate and cavity sizes are visually inferred research approximations, not CAD. Glass and gasket are rigid. No liquid, leakage, polymerization, fracture or compliant contact is simulated. The assembled layout is casting-ready and excludes the comb; final_with_comb is a later illustrative state. Assembly steps and exploded stages are static explanatory layouts, not robot demonstrations. No hidden plate attachments. Cam closure and stand retention require dynamic validation before robotics claims."
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.000090266665, 0.000035909332, 0.000054453332)
    bool physics:kinematicEnabled = 0
    float physics:mass = 0.064
    quatf physics:principalAxes = (1, 0, 0, 0)
    bool physics:rigidBodyEnabled = 1
    bool physxRigidBody:enableCCD = 1
    int physxRigidBody:solverPositionIterationCount = 32
    int physxRigidBody:solverVelocityIterationCount = 8

    def "Looks"
    {
        def Material "Glass" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:mdl:surface.connect = </RearPlate/Looks/Glass/GlassMDL.outputs:out>
            token outputs:surface.connect = </RearPlate/Looks/Glass/Preview.outputs:surface>
            float physics:dynamicFriction = 0.75
            float physics:restitution = 0
            float physics:staticFriction = 0.9

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.985, 0.965)
                float inputs:ior = 1.52
                float inputs:metallic = 0
                float inputs:opacity = 0.12
                float inputs:roughness = 0.025
                token outputs:surface
            }

            def Shader "GlassMDL"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniGlass.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniGlass"
                float inputs:depth = 0.15
                float inputs:frosting_roughness = 0.025
                color3f inputs:glass_color = (0.95, 0.985, 0.965)
                float inputs:glass_ior = 1.52
                bool inputs:thin_walled = 0
                token outputs:out
            }
        }

        def Material "ClearPolycarbonate" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:mdl:surface.connect = </RearPlate/Looks/ClearPolycarbonate/GlassMDL.outputs:out>
