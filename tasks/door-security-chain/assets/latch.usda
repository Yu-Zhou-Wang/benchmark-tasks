#usda 1.0
(
    defaultPrim = "latch"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "latch" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    custom bool physxArticulation:enabledSelfCollisions = 1
    custom int physxArticulation:solverPositionIterationCount = 64
    custom int physxArticulation:solverVelocityIterationCount = 16

    def "looks"
    {
        def Material "wood"
        {
            token outputs:surface.connect = </latch/looks/wood/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.57, 0.3, 0.12)
                float inputs:metallic = 0
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }

        def Material "frame"
        {
            token outputs:surface.connect = </latch/looks/frame/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.73, 0.72, 0.67)
                float inputs:metallic = 0
                float inputs:roughness = 0.75
                token outputs:surface
            }
        }

        def Material "brass"
        {
            token outputs:surface.connect = </latch/looks/brass/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.48, 0.15)
                float inputs:metallic = 0.65
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "steel"
        {
            token outputs:surface.connect = </latch/looks/steel/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.53, 0.58)
                float inputs:metallic = 0.65
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </latch/looks/dark/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.055, 0.06, 0.07)
                float inputs:metallic = 0.2
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }
    }

    def Xform "frame" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.1, 0.1, 0.1)
        float physics:mass = 5
        quatf physics:principalAxes = (1, 0, 0, 0)
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "foot" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding = </latch/looks/frame>
            custom float physxCollision:contactOffset = 0.0005
            custom float physxCollision:restOffset = 0
            double size = 1
            float3 xformOp:scale = (0.18, 0.47, 0.016)
            double3 xformOp:translate = (0.018, -0.18, 0.008)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

